import java.util.Scanner;
/**
 *
 * @author HP
 */
public class Q2 {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        char[][] board = new char[3][3];
        int xCount = 0;
        int oCount = 0;
        boolean fullXRow = false;
        System.out.println("Enter 9 cells (X or O):");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = in.next().charAt(0);
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " ");
            }
            System.out.println();
        }
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (board[i][j] == 'X') {
                    xCount++;
                }
                else if (board[i][j] == 'O') {
                    oCount++;
                }
            }
        }
        System.out.println("X count: " + xCount);
        System.out.println("O count: " + oCount);
        for (int i = 0; i < 3; i++) {
            if (board[i][0] == 'X' &&
                board[i][1] == 'X' &&
                board[i][2] == 'X') {
                fullXRow = true;
            }
        }
        if (fullXRow) {
            System.out.println("X has a full row");
        }
        else {
            System.out.println("No full X row");
        }
    }
}



