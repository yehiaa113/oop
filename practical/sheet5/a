package javaapplication128;
import java.util.Scanner;


/**
 *
 * @author Student
 */
public class JavaApplication128 {
    public static int generateSecret(){
        return (int)(Math.random()*50+1);
    }
    public static String checkGuess(int guess,int secret){
        if(guess==secret){
           return "correct";
        }else if(guess<secret){
            return"higher";
        }else{return"lower";}
        
    }
    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner input=new Scanner(System.in);
        int secret=generateSecret();
        int[]guesses=new int[5];
        int attemps=0;
        for(int i=0;i<5;i++){
            System.out.print("Guess :");
            guesses[i] =input.nextInt();
            attemps++;
             String result=checkGuess(guesses[i],secret);
              System.out.print(result);
              if(result.equals("Correct ")){
                  System.out.print("correct in "+ attemps +"attempts");
                    return;
              }
                           System.out.print("the secret number was "+ secret);

        }
    
    }
    
}





